# Merriam-Webster API Configuration
# Get your free API key at: https://dictionaryapi.com/register/index
MERRIAM_WEBSTER_API_KEY=your_api_key_here

# Anthropic API key — required for reading-passage generation (/api/reading-passage)
ANTHROPIC_API_KEY=your_api_key_here

# Source vocabulary file (default: vocab)
VOCAB_DECK_SOURCE=vocab

# Override where the runtime data dir lives (DB + logs).
# Set this to a persistent-volume mount path in production (e.g. /data/runtime).
# Leave unset for local development — defaults to data/runtime/ inside the repo.
# VOCAB_DECK_RUNTIME_DIR=/data/runtime
